# Copie este arquivo para .streamlit/secrets.toml (ele NÃO vai pro repo)
# e preencha com os valores do seu projeto Supabase.
#
# Onde encontrar:
#   Supabase Dashboard → seu projeto → Settings → API
#   - SUPABASE_URL: campo "Project URL"
#   - SUPABASE_ANON_KEY: campo "anon public" (chave pública)
#
# No Streamlit Cloud: cole esse mesmo conteúdo em
#   App settings → Secrets → Edit secrets
# (sem o arquivo, o app cai automaticamente pro modo local com JSON.)

SUPABASE_URL = "https://xxxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY = "eyJhbGciOi...sua-anon-key..."
